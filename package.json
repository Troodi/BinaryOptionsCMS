        "sass-loader": "^8.0.0",
        "vue-template-compiler": "^2.6.11"
    },
    "dependencies": {
        "jquery": "^3.5.1",
        "laravel-echo": "^1.8.1",
        "laravel-echo-server": "^1.6.2",
        "requirejs": "^2.3.6",
